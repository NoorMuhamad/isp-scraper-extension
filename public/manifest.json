{
  "manifest_version": 3,
  "name": "ISP Finder: Pakistan",
  "version": "2.0.0",
  "description": "Collects internet service providers from Google Maps for the Pakistani cities you enable, and sends them to your Google Sheet.",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://internet-guru.com/*",
    "https://www.internet-guru.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open ISP Finder",
    "default_icon": "image.png"
  },
  "icons": {
    "16": "image.png",
    "48": "image.png",
    "128": "image.png"
  }
}
